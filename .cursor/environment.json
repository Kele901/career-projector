{
  "name": "CV Career Recommender",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ./venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host"
    }
  ],
  "ports": [8000, 5173]
}
